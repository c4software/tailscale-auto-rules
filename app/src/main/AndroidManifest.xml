<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Observation du réseau : indispensable au moteur de règles. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!--
      Lecture du SSID courant. Déclarée ici, mais demandée à l'utilisateur
      uniquement lorsqu'une règle Wi-Fi est activée (SPECS.md §8). Sans elle, le
      système renvoie un SSID de repli, traité comme indisponible.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!--
      Notification d'état. Demandée à l'utilisateur uniquement s'il active
      l'option correspondante (SPECS.md §7 et §8) : l'application n'emploie pas
      de service de premier plan, qui l'aurait rendue obligatoire.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Réarmer l'automatisation après un redémarrage du terminal. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Observation continue du réseau, tant que l'automatisation est activée.
      Aucun type de service prédéfini ne décrit ce besoin : ni synchronisation
      de données, ni appareil connecté, ni localisation. D'où « usage
      particulier », dont le motif est déclaré sur le service lui-même.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!--
      Le SSID relève de la localisation aux yeux d'Android. Depuis Android 10,
      un service n'y a accès que s'il se déclare de type « localisation » : sans
      cela, le nom du réseau revient vide en arrière-plan, et la règle des
      réseaux de confiance ne peut jamais s'appliquer. Constaté sur appareil.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!--
      Sans cette déclaration, Android 11+ répond « paquet introuvable » et
      l'application conclut à tort que le client Tailscale est absent.
    -->
    <queries>
        <package android:name="com.tailscale.ipn" />
    </queries>

    <application
        android:name=".TailscaleAutoRulesApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TailscaleAutoRules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.TailscaleAutoRules">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Observe le réseau tant que le mode immédiat est actif. Non exporté :
          lui seul, et le coordinateur, décident de son cycle de vie.
        -->
        <service
            android:name=".automation.TunnelWatchService"
            android:exported="false"
            android:foregroundServiceType="specialUse|location">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Continuous monitoring of network state in order to enable or disable the Tailscale VPN tunnel according to rules defined by the user. No other foreground service type describes this need: it is neither a data sync, nor a connected device, nor location tracking." />
        </service>

        <receiver
            android:name=".automation.DisableAutomationReceiver"
            android:exported="false" />

        <receiver
            android:name=".automation.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
