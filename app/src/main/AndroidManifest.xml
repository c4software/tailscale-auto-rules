<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Observation du réseau : indispensable au moteur de règles. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!--
      Lecture du SSID courant. Déclarée ici, mais demandée à l'utilisateur
      uniquement lorsqu'une règle Wi-Fi est activée (SPECS.md §8). Sans elle, le
      système renvoie un SSID de repli, traité comme indisponible.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!--
      Sans cette déclaration, Android 11+ répond « paquet introuvable » et
      l'application conclut à tort que le client Tailscale est absent.
    -->
    <queries>
        <package android:name="com.tailscale.ipn" />
    </queries>

    <application
        android:name=".TailscaleAutoRulesApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TailscaleAutoRules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.TailscaleAutoRules">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
